# Salin ke .env untuk lokal. Di Vercel: Project > Settings > Environment Variables, lalu redeploy.
# Key provider HANYA di sini, jangan pernah ditulis di kode.
THERESAV_API_KEY=
BOTCAHX_API_KEY=
DONGTUBE_API_KEY=
# Opsional
SITE_NAME=API Zero
# Alamat publik situs, dipakai untuk link /api/media/... (contoh https://api-zero.web.id)
PUBLIC_BASE_URL=
# String acak panjang untuk enkripsi link media (disarankan diisi)
APP_SECRET=
RATE_LIMIT_PER_MINUTE=60
