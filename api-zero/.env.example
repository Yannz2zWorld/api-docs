# Salin ke .env untuk lokal. Di Vercel: Project > Settings > Environment Variables (Production + Preview), lalu Redeploy.
# Jangan pernah commit .env atau menulis key di kode.

# ---- Wajib
# PostgreSQL (Neon / Supabase / dll). Tabel dibuat otomatis saat pertama jalan.
DATABASE_URL=
# String acak panjang (>= 32 karakter) untuk tanda tangan sesi & enkripsi.
# Buat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Akun developer (pisahkan koma). Saat akun ini login, tier-nya otomatis jadi Developer.
DEVELOPER_USERNAMES=
DEVELOPER_EMAILS=

# ---- Key provider (server-only)
THERESAV_API_KEY=
BOTCAHX_API_KEY=
DONGTUBE_API_KEY=

# ---- Login Google (opsional). OAuth Client ID tipe "Web application";
# Authorized JavaScript origins: https://api-zero.web.id
GOOGLE_CLIENT_ID=

# ---- Lupa sandi via email (SMTP). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=<gmail>, SMTP_PASS=<App Password Google, bukan sandi biasa>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Opsional
SITE_NAME=API Zero
# Alamat publik, dipakai untuk link /api/media/... (contoh https://api-zero.web.id)
PUBLIC_BASE_URL=
# Batas request per menit per IP (semua user), default 120
RATE_LIMIT_PER_MINUTE=120
# Lama plan berbayar dalam hari, default 30
PLAN_DAYS=30
