# Copy to .env for local development. Never commit .env or share real values.
# On Vercel, set these in Project Settings > Environment Variables (Production AND Preview), then redeploy.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://apiz2z.vercel.app/auth/google/callback
# Long random value (>= 32 chars), e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
OWNER_EMAIL=
# Optional
CORS_ORIGINS=
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_V2_VERIFY_URL=
MANUAL_PAYMENT_INSTRUCTIONS=
# WhatsApp number for the buyer's "Kirim via WhatsApp" link (digits, e.g. 62812...). Defaults to settings.js.
OWNER_WA=
# Telegram owner notification for manual payments (bot from @BotFather + your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Email codes (register verification + forgot password), sent as "YannApi".
# EMAIL_FROM is the sender address. Pick ONE provider:
#  - SMTP (e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail>, SMTP_PASS=<Google App Password>)
#  - Resend: RESEND_API_KEY (EMAIL_FROM must be on a domain verified in Resend)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESEND_API_KEY=
# Optional tuning (per-instance, best effort)
RATE_LIMIT_PER_MINUTE=
AUTH_RATE_LIMIT_PER_15MIN=
# Invalid API keys per IP per 15 minutes before key auth is blocked for that IP (default 30)
INVALID_KEY_LIMIT_PER_15MIN=
# Tests only: a disposable PostgreSQL for `npm run test:integration` (never production)
TEST_DATABASE_URL=
