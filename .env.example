# Copy to .env for local development. Never commit .env or share real values.
# On Vercel, set these in Project Settings > Environment Variables (Production AND Preview), then redeploy.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://apiz2z.vercel.app/auth/google/callback
# Long random value (>= 32 chars), e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
OWNER_EMAIL=
# Optional
CORS_ORIGINS=
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_V2_VERIFY_URL=
MANUAL_PAYMENT_INSTRUCTIONS=
OWNER_WA=
# Optional tuning (per-instance, best effort)
RATE_LIMIT_PER_MINUTE=
AUTH_RATE_LIMIT_PER_15MIN=
# Tests only: a disposable PostgreSQL for `npm run test:integration` (never production)
TEST_DATABASE_URL=
