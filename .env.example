# Copy to .env for local development. Never commit .env or share real values.
# On Vercel, set these in Project Settings > Environment Variables (Production AND Preview), then redeploy.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://apiz2z.vercel.app/auth/google/callback
# Long random value (>= 32 chars), e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
OWNER_EMAIL=
# Optional
CORS_ORIGINS=
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_V2_VERIFY_URL=
MANUAL_PAYMENT_INSTRUCTIONS=
# WhatsApp number for the buyer's "Kirim via WhatsApp" link (digits, e.g. 62812...). Defaults to settings.js.
OWNER_WA=
# Email codes (register verification + forgot password), sent as "YannApi".
# EMAIL_FROM is the sender address. Pick ONE provider:
#  - SMTP (e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail>, SMTP_PASS=<Google App Password>)
#  - Resend: RESEND_API_KEY (EMAIL_FROM must be on a domain verified in Resend)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESEND_API_KEY=
# Public address of the site, used for CDN links (e.g. https://apiz2z.web.id)
PUBLIC_BASE_URL=
# Third-party API servers (keys only here, never in code)
THERESAV_API_KEY=
CLUTCH_API_KEY=
TERMAI_API_KEY=
# Cloudflare R2 for large CDN uploads (up to 200 MB). Used instead of catbox when all five are set.
# R2_PUBLIC_URL is the bucket's public URL (Settings > Public access > r2.dev), no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Large CDN uploads without R2 go from the browser straight to catbox.moe (free, max 200 MB);
# the shared link stays https://<domain>/cdn/... Set to "off" to keep uploads at 4 MB.
CDN_CATBOX=
# Max total size of active CDN files per account in MB (default 2048, 0 = no limit; developer exempt)
CDN_ACCOUNT_LIMIT_MB=
# Cloudflare Turnstile captcha on sign-in / register (both or neither)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Developer panel "Add endpoint" (fine-grained token, Contents read & write on this repo only)
GITHUB_TOKEN=
# Set to "on" to turn the Pakasir payment gateway back on
PAYMENT_GATEWAY=
# Optional tuning (per-instance, best effort)
RATE_LIMIT_PER_MINUTE=
AUTH_RATE_LIMIT_PER_15MIN=
# Invalid API keys per IP per 15 minutes before key auth is blocked for that IP (default 30)
INVALID_KEY_LIMIT_PER_15MIN=
# Tests only: a disposable PostgreSQL for `npm run test:integration` (never production)
TEST_DATABASE_URL=
