{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "migrations/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/cron/backup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/cron/endpoint-check",
      "schedule": "0 18 * * *"
    }
  ]
}
