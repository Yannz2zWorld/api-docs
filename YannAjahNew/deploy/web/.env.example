# YannAjah Web Database — salin ke .env lalu isi (install-vps.sh mengisinya otomatis).
# JANGAN bagikan file .env asli.
NODE_ENV=production

# PostgreSQL khusus YannAjah (lokal di VPS, atau Neon: postgresql://...neon.tech/...?sslmode=require)
DATABASE_URL=postgres://yannajah_app:GANTI_PASSWORD@127.0.0.1:5432/yannajah
# DATABASE_SCHEMA=

# 127.0.0.1 kalau di belakang nginx / Cloudflare Tunnel; 0.0.0.0 kalau lewat "Managed Domain" panel VPS NAT
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Alamat web database (HTTPS). Alamat yang sama dipakai saat build bot: --license-url
DASHBOARD_PUBLIC_URL=https://lisensi.domainkamu.com
DASHBOARD_TRUST_PROXY=true

# Minimal 32 karakter acak: openssl rand -hex 32
SESSION_SECRET=
# Kunci enkripsi backup (minimal 16 karakter; simpan juga di tempat aman terpisah dari server)
BACKUP_ENCRYPTION_KEY=

# Opsional
# BOT_SESSION_DAYS=30
# ADMIN_SESSION_HOURS=12
# BCRYPT_COST=12
