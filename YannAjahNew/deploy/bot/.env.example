# YannAjah AI (bot) - salin ke .env lalu isi.
# Nama bot, owner, prefix, pairing, dll. diatur di settingsbot.js (bukan di sini).
# Tautan web database sudah tertanam di yannajah.js.

# API key APIZ2Z sudah diisi di settingsbot.js (global.apikeyapiz2z).
# Isi di sini hanya kalau mau menimpanya.
# APIZ2Z_API_KEY=

# Opsional: login pertama tanpa console. Di panel Pterodactyl tidak perlu (ketik di console).
# BOT_AUTH_PHONE=
# BOT_AUTH_PASSWORD=
