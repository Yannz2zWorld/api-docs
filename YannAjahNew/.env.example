# YannAjahNew — contoh environment. Salin ke .env lalu isi. JANGAN commit file .env asli.
# Semua secret hanya di sini / panel hosting / secret manager, tidak pernah di source code.

# ------------------------------------------------------------------ BOT (index.js)
# URL backend lisensi (server/). Wajib HTTPS di production (http hanya untuk localhost).
LICENSE_SERVER_URL=https://lisensi.domainkamu.com
# Nama instance bot ini (unik per proses bot).
BOT_INSTANCE_NAME=yannajah-main
# Folder session WhatsApp (satu folder = satu proses bot).
SESSION_DIR=session
# Metode pairing saat belum ada session: ask | qr | pairing
PAIRING_METHOD=ask
# Custom pairing code tepat 8 karakter huruf besar/angka. Kosong = pakai default di settingsbot.js (YANNAJAH).
PAIRING_CUSTOM_CODE=
# Owner bot (nomor internasional tanpa +).
OWNER_NUMBER=6281234567890
OWNER_NAME=Owner
# Login PERTAMA tanpa terminal interaktif (panel hosting). Setelah login berhasil token disimpan
# di library/database/license-session.json dan dua variabel ini sebaiknya DIHAPUS.
# BOT_AUTH_PHONE=
# BOT_AUTH_PASSWORD=

# API key APIZ2Z (buat di https://apiz2z.web.id -> menu API key). Dikirim lewat header Authorization.
APIZ2Z_API_KEY=
# APIZ2Z_BASE_URL=https://apiz2z.web.id

# Opsional
# BOT_PREFIX=.,!,#,/
# LOG_LEVEL=info
# LIMIT_HARIAN=10
# FOLLOW_CHANNEL=false
# FFMPEG_PATH=ffmpeg
# Batas CPU ffmpeg (VPS bersama: total CPU tidak boleh >100% terus-menerus)
# MEDIA_MAX_CONCURRENT=1
# FFMPEG_THREADS=1

# ------------------------------------------------------------------ BACKEND + DASHBOARD (server/)
NODE_ENV=production
# PostgreSQL. Pakai database KHUSUS YannAjahNew (jangan campur dengan database platform APIZ2Z).
DATABASE_URL=postgres://yannajah_app:GANTI_PASSWORD@127.0.0.1:5432/yannajah
# DATABASE_SCHEMA=
# 127.0.0.1 kalau lewat Cloudflare Tunnel; 0.0.0.0 kalau lewat "Managed Domain" panel VPS NAT
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=https://lisensi.domainkamu.com
DASHBOARD_TRUST_PROXY=true
# Minimal 32 karakter acak: openssl rand -hex 32
SESSION_SECRET=
# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://lisensi.domainkamu.com/auth/google/callback
# true = akun Google baru boleh daftar sebagai MEMBER; false = hanya email yang sudah dibuat admin
DASHBOARD_OPEN_SIGNUP=true
# Kunci enkripsi backup (minimal 16 karakter; simpan juga di tempat aman terpisah dari server)
BACKUP_ENCRYPTION_KEY=

# ------------------------------------------------------------------ TEST (jangan pernah sama dengan DATABASE_URL)
# TEST_DATABASE_URL=postgres://yannajah_test:yannajah_test@127.0.0.1:5432/yannajah_test
